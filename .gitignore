__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# dados baixados do MOT17 (grandes, não vão pro git) -- tudo dentro de data/,
# independente do nome da subpasta (data/MOT17/, data/MOT17_SITE/, etc.)
data/
*.zip

# checkpoints grandes ficam fora do git (link no README); os pequenos
# (o MotionGRU da Parte 2 tem ~58KB cada) são versionados normalmente --
# listados explicitamente abaixo em vez de bloqueados por padrão.
checkpoints/*.pt
checkpoints/*.pth
!checkpoints/.gitkeep
!checkpoints/motion_gru_mot17.pt
!checkpoints/motion_gru_pretrain_synthetic.pt

outputs/**/*.mp4
outputs/**/*.avi

# rascunho pessoal de apresentação, não é entregável do PA
slides_notes.md
slides_notes.txt
